{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["cypress", "node"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": [
    "../cypress.config.ts",
    "../projects/material-addons/src/**/*.cy.ts",
    "./support/**/*.ts",
    "./*.ts"
  ],
  "exclude": [
    "../dist",
    "../node_modules",
    "../projects/material-addons/src/**/*.spec.ts"
  ]
}
