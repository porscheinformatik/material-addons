{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "files": ["../../setup-jest.ts"],
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"],
  "exclude": ["../../dist", "../../node_modules", "src/**/*.cy.ts"]
}
